[Unit]
Description=Ambient light sysfs IIO bridge for Steam adaptive brightness
# The SSC data source lives behind these two services. The unit is skipped
# entirely when the matching kernel did not ship the als-bridge module.
Requires=hexagonrpcd-sensors.service iio-sensor-proxy.service
After=hexagonrpcd-sensors.service iio-sensor-proxy.service
ConditionPathExists=/sys/module/als_bridge/parameters/lux
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/lib/alsbridge/als-bridge-daemon.py
Restart=always
RestartSec=3s

[Install]
WantedBy=multi-user.target
