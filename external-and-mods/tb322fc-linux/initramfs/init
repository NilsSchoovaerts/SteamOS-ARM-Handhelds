#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Mount only the dedicated rootfs partition, then hand off to its init.
export PATH=/bin:/sbin
BB=/bin/busybox

fail() {
    echo "Rootfs handoff failed: $*" >&2
    echo "No recovery writes or automatic reboot will be attempted." >&2
    while :; do "$BB" sleep 3600; done
}

"$BB" mount -t proc proc /proc || fail "mount proc"
"$BB" mount -t sysfs sysfs /sys || fail "mount sysfs"
"$BB" mount -t devtmpfs devtmpfs /dev || fail "mount devtmpfs"

selector=PARTLABEL=rootfs
for option in $("$BB" cat /proc/cmdline); do
    case "$option" in root=*) selector=${option#root=} ;; esac
done
case "$selector" in
    PARTLABEL=rootfs|PARTUUID=*) ;;
    *) fail "use root=PARTLABEL=rootfs or root=PARTUUID=<rootfs UUID>" ;;
esac

root_device=
for attempt in $("$BB" seq 1 60); do
    complete=1
    for disk in sda sdb sdc sdd sde sdf; do
        [ -b "/dev/$disk" ] || complete=0
    done
    if [ "$complete" -eq 0 ]; then
        "$BB" sleep 1
        continue
    fi
    matches=0
    for node in /sys/class/block/sd*; do
        [ -f "$node/partition" ] || continue
        "$BB" grep -qx 'PARTNAME=rootfs' "$node/uevent" || continue
        if [ "$selector" != PARTLABEL=rootfs ]; then
            "$BB" grep -qxF "$selector" "$node/uevent" || continue
        fi
        root_device=/dev/${node##*/}
        root_node=$node
        matches=$((matches + 1))
    done
    [ "$matches" -le 1 ] || fail "ambiguous rootfs partition"
    [ "$matches" -eq 0 ] || break
    "$BB" sleep 1
done
[ -n "$root_device" ] || fail "rootfs partition not found"
root_parent=$("$BB" dirname "$("$BB" readlink -f "$root_node")")
root_parent=${root_parent##*/}

# Setting the root disk read-only would also make rootfs read-only. Protect
# its siblings individually, and protect all other enumerated UFS disks.
for node in /sys/class/block/sd*; do
    device=/dev/${node##*/}
    [ -b "$device" ] || continue
    [ "$device" = "$root_device" ] && continue
    [ "$device" = "/dev/$root_parent" ] && continue
    "$BB" blockdev --setro "$device" || fail "protect $device"
done
[ "$("$BB" blockdev --getro "$root_device")" = 0 ] || fail "rootfs is read-only"

"$BB" mkdir -p /newroot /run
"$BB" mount -t ext4 -o rw,noatime,errors=remount-ro "$root_device" /newroot || fail "mount rootfs"
[ -x /newroot/sbin/init ] || fail "rootfs lacks /sbin/init"
"$BB" mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run || fail "mount run"

# Keep early firmware available across switch_root without modifying /usr.
# Built-in drivers may request more files after the initial probe completes.
"$BB" mkdir -p /run/firmware
"$BB" cp -a /lib/firmware/. /run/firmware/ || fail "retain firmware"
echo /run/firmware > /sys/module/firmware_class/parameters/path || fail "set firmware path"

"$BB" mkdir -p /newroot/dev /newroot/proc /newroot/sys /newroot/run
# Keep /run/firmware reachable from both roots while switch_root deletes
# the old /lib/firmware. Moving /run would leave asynchronous firmware
# requests without either search path until the final chroot completes.
"$BB" mount --bind /run /newroot/run || fail "bind run"
for filesystem in dev proc sys; do
    "$BB" mount --move "/$filesystem" "/newroot/$filesystem" || fail "move $filesystem"
done
exec "$BB" switch_root /newroot /sbin/init
fail "switch_root returned"
